{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C/C++: 현재 파일 디버깅 (단일 파일용)",
      "type": "cppdbg",
      "request": "launch",
      // tasks.json에서 만든 exe 파일 경로와 똑같이 맞춤
      "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      // 디버깅 시작 전 tasks.json의 "C: 현재 파일만 빌드 (단일 알고리즘용)"를 먼저 실행
      "preLaunchTask": "C: 현재 파일만 빌드 (단일 알고리즘용)"
    },
    {
      "name": "C/C++: app.exe 디버깅 (프로젝트용)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\app.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "build c"
    },
    {
      "name": "Mocha Tests (Node)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/mocha/bin/mocha",
      "args": [
        "-u", "bdd", "--timeout", "999999", "--colors", "${workspaceFolder}/tests/**/*.test.ts"
      ],
      "internalConsoleOptions": "openOnSessionStart",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}